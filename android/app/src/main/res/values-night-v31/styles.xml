<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash screen from the launch theme. The icon
         is the adaptive foreground on the same navy plate, so the system splash
         and the app's first frame are one continuous colour. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/avalon_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/avalon_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/avalon_launcher_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
