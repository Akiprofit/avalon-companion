<?xml version="1.0" encoding="utf-8"?>
<!-- The native launch screen: the icon art centred on the app's navy plate, so
     the first frame is the same colour as the Flutter splash that follows it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/avalon_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/avalon_splash" />
    </item>
</layer-list>
